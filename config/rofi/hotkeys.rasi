/* ---- Configuration ---- */
@import "~/.config/rofi/config.rasi" 

/* ---- Main Window ---- */
window {
    width: 40%;
    height: 50%;
}

/* ---- Entry (Search) ---- */
entry {
    placeholder: " ⌨️ Search Shortcuts";
}

/* ---- Listview ---- */
listview {
    columns: 1;
    lines: 12;
    fixed-height: false;
}
